+        "risk_band": "Wilderness risk",
+        "state": "Wilderness risk",
+    }
+    yield "risk:poison-escalation", _player(
+        combat_auto_eat_food=[]
+    ), "poison_scorpion", {
+        "outcome": "return",
+        "risk_band": "Food advised",
+        "state": "Ready",
+    }
+
+
+def capture(function, player, target_id):
+    from ankiscape.core.constants import EQUIPMENT_DATA
+    from ankiscape.data.combat_data import COMBAT_ENEMY_DATA
+
+    supplied_player = deepcopy(player)
+    supplied_enemies = deepcopy(COMBAT_ENEMY_DATA)
+    supplied_equipment = deepcopy(EQUIPMENT_DATA)
+    try:
+        result = function(
+            supplied_player,
+            target_id,
+            supplied_enemies,
+            supplied_equipment,
+        )
+    except Exception as error:  # preserve the preview's public failure contract
+        outcome = {
+            "outcome": "raise",
+            "exception": (
+                f"{type(error).__module__}.{type(error).__qualname__}"
+            ),
+            "args": deepcopy(error.args),
+            "message": str(error),
+        }
+    else:
+        outcome = {"outcome": "return", "value": deepcopy(result)}
+    return {
+        **outcome,
+        "inputs_unchanged": {
+            "player": supplied_player == player,
+            "enemies": supplied_enemies == COMBAT_ENEMY_DATA,
+            "equipment": supplied_equipment == EQUIPMENT_DATA,
+        },
+    }
+
+
+def route_observation(captured):
+    if captured["outcome"] == "raise":
+        return {
+            "outcome": "raise",
+            "exception": captured["exception"],
+        }
+    return {
+        "outcome": "return",
+        "risk_band": captured["value"]["risk_band"],
+        "state": captured["value"]["state"],
+    }
+
+
+def compare(baseline_bytes):
+    import pkg_alias  # noqa: F401  (installs the ankiscape package alias)
+    from ankiscape.logic_pure import logic_pure_combat_engine as candidate
+
+    baseline = types.ModuleType("ankiscape.logic_pure._frozen_preview_food_engine")
+    baseline.__package__ = "ankiscape.logic_pure"
+    exec(
+        compile(baseline_bytes, "<frozen-preview-food-engine>", "exec"),
+        baseline.__dict__,
+    )
+    rows = []
+    for label, player, target_id, expected in cases():
+        before = capture(
+            baseline.combat_target_preview_pure, player, target_id
+        )
+        after = capture(candidate.combat_target_preview_pure, player, target_id)
+        before_bytes = pickle.dumps(before, protocol=4)
+        after_bytes = pickle.dumps(after, protocol=4)
+        observed = route_observation(after)
+        rows.append(
+            {
+                "case": label,
+                "equal": before == after,
+                "pickle_bytes_equal": before_bytes == after_bytes,
+                "route_expected": expected,
+                "route_observed": observed,
+                "route_pass": observed == expected,
+                "inputs_unchanged": after["inputs_unchanged"],
+                "baseline_pickle_base64": base64.b64encode(
+                    before_bytes
+                ).decode(),
+                "candidate_pickle_base64": base64.b64encode(
+                    after_bytes
+                ).decode(),
+            }
+        )
+    return rows
+
+
+def main():
+    if sys.flags.optimize or "PYTHONOPTIMIZE" in os.environ:
+        raise SystemExit(
+            "Optimized interpreter refused; product imports not started."
+        )
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument(
+        "--root", type=Path, default=Path(__file__).resolve().parents[2]
+    )
+    parser.add_argument("--inventory", required=True, type=Path)
+    parser.add_argument("--inventory-sha256", required=True)
+    parser.add_argument("--output", required=True, type=Path)
+    parser.add_argument("--preflight", action="store_true")
+    args = parser.parse_args()
+    sources, baseline = source_guard(
+        args.root, args.inventory, args.inventory_sha256
+    )
+    report = {
+        "baseline_commit": BASELINE_COMMIT,
+        "baseline_engine_sha256": BASELINE_ENGINE_SHA256,
+        "baseline_supplies_sha256": BASELINE_SUPPLIES_SHA256,
+        "baseline_model_sha256": BASELINE_MODEL_SHA256,
+        "inventory_sha256": args.inventory_sha256,
+        "sources_before": sources,
+        "rng_applicable": False,
+    }
+    if args.preflight:
+        product_modules = sorted(
+            name
+            for name in sys.modules
+            if name == "pkg_alias"
+            or name.split(".")[0] in {"ankiscape", "tests"}
+        )
+        if product_modules:
+            raise RuntimeError(
+                f"Product imported during preflight: {product_modules}"
+            )
+        report.update(
+            status="PREFLIGHT_PASS",
+            product_imported=False,
+            product_modules=product_modules,
+        )
+    else:
+        sys.path.insert(0, str(args.root))
+        rows = compare(baseline)
+        report.update(
+            cases=rows,
+            status=(
+                "PASS"
+                if all(
+                    row["equal"]
+                    and row["pickle_bytes_equal"]
+                    and row["route_pass"]
+                    and all(row["inputs_unchanged"].values())
+                    for row in rows
+                )
+                else "FAIL"
+            ),
+        )
+    report["sources_after"], _ = source_guard(
+        args.root, args.inventory, args.inventory_sha256
+    )
+    args.output.write_text(json.dumps(report, indent=2) + "\n")
+    if report["status"] == "FAIL":
+        raise SystemExit("Preview comparison or route assertions failed.")
+
+
+if __name__ == "__main__":
+    main()
