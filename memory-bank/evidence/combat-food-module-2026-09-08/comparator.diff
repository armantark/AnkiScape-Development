+def source_guard(root, inventory, inventory_sha256):
+    inventory_bytes = inventory.read_bytes()
+    if hashlib.sha256(inventory_bytes).hexdigest() != inventory_sha256:
+        raise ValueError("Inventory hash differs; product imports not started.")
+    expected = json.loads(gzip.decompress(inventory_bytes))
+    for required in (
+        ENGINE_PATH,
+        SUPPLIES_PATH,
+        MODEL_PATH,
+        FOOD_PATH,
+        TEST_PATH,
+    ):
+        if required not in expected:
+            raise ValueError(
+                f"Inventory omits {required}; product imports not started."
+            )
+    actual = {}
+    for name, pin in expected.items():
+        source = root / name
+        if not source.is_file():
+            raise ValueError(
+                f"Source missing: {name}; product imports not started."
+            )
+        digest = hashlib.sha256(source.read_bytes()).hexdigest()
+        if digest != pin:
+            raise ValueError(
+                f"Source differs: {name}; product imports not started."
+            )
+        actual[name] = digest
+
+    evidence = root / "memory-bank/evidence/combat-food-module-2026-09-08"
+    stored_engine = (evidence / "baseline-engine.py.gz").read_bytes()
+    if hashlib.sha256(stored_engine).hexdigest() != BASELINE_ENGINE_STORED_SHA256:
+        raise ValueError(
+            "Stored engine baseline differs; product imports not started."
+        )
+    baseline_engine = gzip.decompress(stored_engine)
+    if hashlib.sha256(baseline_engine).hexdigest() != BASELINE_ENGINE_SHA256:
+        raise ValueError(
+            "Engine baseline source differs; product imports not started."
+        )
+
+    stored_supplies = (evidence / "baseline-supplies.py.gz").read_bytes()
+    if (
+        hashlib.sha256(stored_supplies).hexdigest()
+        != BASELINE_SUPPLIES_STORED_SHA256
+    ):
+        raise ValueError(
+            "Stored supplies baseline differs; product imports not started."
+        )
+    if (
+        hashlib.sha256(gzip.decompress(stored_supplies)).hexdigest()
+        != BASELINE_SUPPLIES_SHA256
+    ):
+        raise ValueError(
+            "Supplies baseline source differs; product imports not started."
+        )
+
+    stored_model = (evidence / "baseline-model.py.gz").read_bytes()
+    if hashlib.sha256(stored_model).hexdigest() != BASELINE_MODEL_STORED_SHA256:
+        raise ValueError(
+            "Stored model baseline differs; product imports not started."
+        )
+    if (
+        hashlib.sha256(gzip.decompress(stored_model)).hexdigest()
+        != BASELINE_MODEL_SHA256
+    ):
+        raise ValueError(
+            "Model baseline source differs; product imports not started."
+        )
+    return actual, baseline_engine
+
+
+def cases():
+    from tests.combat.test_preview_food import preview_food_player
+    from tests.test_combat_logic import _player
+
+    missing_selection = preview_food_player(inventory={"Shrimps": 1})
+    missing_selection.pop("combat_auto_eat_food")
+    yield "selection:missing-default", missing_selection, "giant_rat", {
+        "outcome": "return",
+        "risk_band": "Food advised",
+        "state": "Ready",
+    }
+    yield "selection:empty", preview_food_player(
+        inventory={"Shrimps": 1}, combat_auto_eat_food=[]
+    ), "giant_rat", {
+        "outcome": "return",
+        "risk_band": "Death possible",
+        "state": "Ready",
+    }
+    yield "selection:none", preview_food_player(
+        inventory={"Shrimps": 1}, combat_auto_eat_food=None
+    ), "giant_rat", {
+        "outcome": "raise",
+        "exception": "builtins.TypeError",
+    }
+    yield "catalog:unsupported", preview_food_player(
+        inventory={"Burnt fish": 10},
+        combat_auto_eat_food=["Burnt fish"],
+        combat_supply_loadout={"food": {"Burnt fish": 10}},
+    ), "giant_rat", {
+        "outcome": "return",
+        "risk_band": "Death possible",
+        "state": "Ready",
+    }
+    yield "source:bank-ready", preview_food_player(
+        inventory={"Shrimps": 1}
+    ), "giant_rat", {
+        "outcome": "return",
+        "risk_band": "Food advised",
+        "state": "Ready",
+    }
+    yield "source:bank-gated-during-encounter", preview_food_player(
+        inventory={"Shrimps": 1},
+        combat_encounter={"target_id": "giant_rat"},
+    ), "giant_rat", {
+        "outcome": "return",
+        "risk_band": "Death possible",
+        "state": "Fighting",
+    }
+    yield "source:loadout-during-encounter", preview_food_player(
+        inventory={},
+        combat_supply_loadout={"food": {"Shrimps": 1}},
+        combat_encounter={"target_id": "giant_rat"},
+    ), "giant_rat", {
+        "outcome": "return",
+        "risk_band": "Food advised",
+        "state": "Fighting",
+    }
+    yield "count:negative-clamped", preview_food_player(
+        inventory={"Shrimps": -5},
+        combat_supply_loadout={"food": {"Shrimps": -3}},
+    ), "giant_rat", {
+        "outcome": "return",
+        "risk_band": "Death possible",
+        "state": "Ready",
+    }
+    yield "inventory:invalid-truthy-ready", preview_food_player(
+        inventory="truthy invalid inventory"
+    ), "giant_rat", {
+        "outcome": "raise",
+        "exception": "builtins.AttributeError",
+    }
+    yield "inventory:invalid-truthy-gated", preview_food_player(
+        inventory="truthy invalid inventory",
+        combat_encounter={"target_id": "giant_rat"},
+    ), "giant_rat", {
+        "outcome": "return",
+        "risk_band": "Death possible",
+        "state": "Fighting",
+    }
+    yield "selection:unhashable", preview_food_player(
+        combat_auto_eat_food=[[]]
+    ), "giant_rat", {
+        "outcome": "raise",
+        "exception": "builtins.TypeError",
+    }
+    yield "selection:short-circuit-before-unhashable", preview_food_player(
+        inventory={"Shrimps": 1}, combat_auto_eat_food=["Shrimps", []]
+    ), "giant_rat", {
+        "outcome": "return",
+        "risk_band": "Food advised",
+        "state": "Ready",
+    }
+    yield "risk:safe-threshold", preview_food_player(
+        constitution_level=10,
+        combat_lifepoints=100,
+        combat_auto_eat_food=[],
+    ), "giant_rat", {
+        "outcome": "return",
+        "risk_band": "Safe",
