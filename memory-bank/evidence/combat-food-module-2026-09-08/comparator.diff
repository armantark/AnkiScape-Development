+    }
+    yield "risk:wilderness-overwrite", _player(
+        current_combat_target="earth_warrior",
+        constitution_level=99,
+        combat_lifepoints=990,
+        combat_auto_eat_food=[],
+        equipment={
+            "weapon": "Rune sword",
+            "body": "Rune platebody",
+            "head": "Rune full helm",
+            "shield": "Iron kiteshield",
+            "cape": "Cape",
+        },
+    ), "earth_warrior", {
